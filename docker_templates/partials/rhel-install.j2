# Install JDK 8 (x86_64 from internal RHEL8 portable tarball; others from Temurin with GPG+SHA256)
RUN set -eux; \
    ARCH="$(rpm --query --queryformat='%{ARCH}' rpm)"; \
    case "${ARCH}" in \
       aarch64) \
         ESUM='d8a1aecea0913b7a1e0d737ba6f7ea99059b3f6fd17813d4a24e8b3fc3aee278'; \
         BINARY_URL='https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u452-b09/OpenJDK8U-jdk_aarch64_linux_hotspot_8u452b09.tar.gz'; \
         ;; \
       ppc64le) \
         ESUM='ff6e0f7fad0f46fea47193b95e4187e294ba69bb9059704f5df9f2fb74125732'; \
         BINARY_URL='https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u452-b09/OpenJDK8U-jdk_ppc64le_linux_hotspot_8u452b09.tar.gz'; \
         ;; \
       x86_64) \
         BINARY_URL='https://sfile.generali.co.id/files/openjdk/java-1.8.0-openjdk-portable-1.8.0.452.b09-1.portable.jdk.el.x86_64.tar.xz'; \
         ;; \
       *) echo "Unsupported arch: ${ARCH}"; exit 1; \
    esac; \
    if [ "${ARCH}" = "x86_64" ]; then \
        wget --progress=dot:giga -O /tmp/openjdk.tar.xz ${BINARY_URL}; \
        mkdir -p "$JAVA_HOME"; \
        tar -xJf /tmp/openjdk.tar.xz -C "$JAVA_HOME" --strip-components 1 --no-same-owner; \
        rm -f /tmp/openjdk.tar.xz; \
    else \
        wget --progress=dot:giga -O /tmp/openjdk.tar.gz ${BINARY_URL}; \
        wget --progress=dot:giga -O /tmp/openjdk.tar.gz.sig ${BINARY_URL}.sig; \
        export GNUPGHOME="$(mktemp -d)"; \
        gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 3B04D753C9050D9A5D343F39843C48A565F8F04B; \
        gpg --batch --verify /tmp/openjdk.tar.gz.sig /tmp/openjdk.tar.gz; \
        rm -rf "${GNUPGHOME}" /tmp/openjdk.tar.gz.sig; \
        echo "${ESUM} */tmp/openjdk.tar.gz" | sha256sum -c -; \
        mkdir -p "$JAVA_HOME"; \
        tar -xzf /tmp/openjdk.tar.gz -C "$JAVA_HOME" --strip-components 1 --no-same-owner; \
        rm -f /tmp/openjdk.tar.gz; \
    fi; \
    rm -f ${JAVA_HOME}/src.zip
